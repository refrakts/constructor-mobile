# Copy to terraform.tfvars (gitignored) and fill in. Contains SECRETS that land
# in TF state — keep terraform.tfvars local and the R2 state bucket private.

cloudflare_account_id = ""
cloudflare_api_token  = "" # Workers Scripts + KV + Routes edit

# Absolute path to this monorepo checkout (for the build local-exec):
project_root = "<absolute-path-to-this-repo>"

name_suffix = "prod"

# Non-secret config:
control_plane_url      = "https://<your-control-plane>.workers.dev"
ws_url                 = "wss://<your-control-plane>.workers.dev"
github_oauth_client_id = ""

# Optional custom domain (else *.workers.dev). Requires zone_id.
# zone_id               = ""
# gateway_custom_domain = "gateway.example.com"

# Secrets (DO NOT COMMIT):
internal_callback_secret   = ""
github_oauth_client_secret = ""
app_jwt_signing_key        = ""
expo_access_token          = ""
